
config service 'main'
	option enabled '1'
	option port '3000'
	option site_name '映湾'
	option workdir '/opt/yingbay'
	option pin ''

config iptv 'iptv'
	option vendor 'zte'
	option auth_url ''
	option epg_url ''
	option user_id ''
	option password ''
	option mac ''
	option stb_id ''
	option user_ip ''
	option play_mode 'rtp2http'
	option udpxy_url ''
	option epg_xml_url ''

config drive
	option id 'demo'
	option name '演示片库'
	option type 'demo'
	option enabled '1'
