#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/opt/yingbay/server/index.js
WORKDIR=/opt/yingbay

start_service() {
  config_load yingbay
  config_get_bool enabled main enabled 1
  [ "$enabled" = 1 ] || return 0
  config_get port main port 3000
  config_get workdir main workdir "$WORKDIR"

  procd_open_instance
  procd_set_param command node "$workdir/server/index.js"
  procd_set_param cwd "$workdir"
  procd_set_param env PORT="$port" YINGBAY_UCI=1
  procd_set_param pidfile /var/run/yingbay.pid
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

reload_service() {
  stop
  start
}

service_triggers() {
  procd_add_reload_trigger yingbay
}
