#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/opt/yingbay/server/index.js
WORKDIR=/opt/yingbay

start_service() {
  procd_open_instance
  procd_set_param command node "$PROG"
  procd_set_param cwd "$WORKDIR"
  procd_set_param env PORT=3000
  procd_set_param respawn
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
